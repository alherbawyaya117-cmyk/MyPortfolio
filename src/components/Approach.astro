---
import type { Copy } from '../i18n';
import SectionHead from './SectionHead.astro';

interface Props {
  c: Copy;
}

const { c } = Astro.props;
---

<section id="approach" class="band" aria-labelledby="approach-title">
  <div class="wrap inner">
    <SectionHead num="03" label={c.nav.sections.approach} tone="band" />
    <h2 id="approach-title" class="display-h2 title">{c.approach.title}</h2>
    <ol class="grid">
      {
        c.approach.items.map((item) => (
          <li>
            <span class="mark" aria-hidden="true">
              {item.mark}
            </span>
            <h3 class="display-h3">{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .band {
    background: var(--band);
    color: var(--band-ink);
  }

  .inner {
    padding-block: clamp(64px, 10vw, 128px);
  }

  .title {
    max-width: 16ch;
    padding-block: clamp(28px, 5vw, 48px) clamp(36px, 5vw, 56px);
    color: var(--band-ink);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    column-gap: clamp(24px, 4vw, 56px);
  }

  li {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-block: 20px 32px;
    border-block-start: 1px solid var(--band-rule);
  }

  .mark {
    font-family: var(--font-display);
    font-style: var(--emphasis);
    font-size: 1.75rem;
    line-height: 1;
    color: var(--band-accent);
  }

  h3 {
    color: var(--band-ink);
  }

  p {
    max-width: 40ch;
    color: var(--band-muted);
  }
</style>
