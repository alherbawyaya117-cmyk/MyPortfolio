---
import type { Copy } from '../i18n';
import SectionHead from './SectionHead.astro';

interface Props {
  c: Copy;
}

const { c } = Astro.props;
---

<section id="about" class="wrap section" aria-labelledby="about-title">
  <SectionHead num="01" label={c.nav.sections.about} />
  <div class="cols">
    <div class="story">
      <h2 id="about-title" class="display-h2">{c.about.title}</h2>
      {c.about.paragraphs.map((paragraph) => <p class="prose">{paragraph}</p>)}
    </div>
    <dl class="facts">
      {
        c.about.facts.map((fact) => (
          <div>
            <dt class="label">{fact.term}</dt>
            <dd>{fact.detail}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .cols {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(32px, 6vw, 96px);
    padding-block-start: clamp(28px, 5vw, 48px);
  }

  .story {
    flex: 1 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .story h2 {
    margin-block-end: 6px;
  }

  /* Drop cap on the English story only; Arabic letters join, so they can't be split off. */
  .story:lang(en) p:first-of-type::first-letter {
    float: left;
    margin: 0.08em 0.1em 0 0;
    font-family: var(--font-display);
    font-size: 4.4em;
    line-height: 0.8;
    color: var(--heading);
  }

  .facts {
    flex: 1 1 260px;
    max-width: 420px;
  }

  .facts div {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-block: 14px 16px;
    border-block-start: 1px solid var(--rule);
  }

  dd {
    font-family: var(--font-display);
    font-size: var(--fact);
    line-height: 1.4;
    color: var(--heading);
  }
</style>
