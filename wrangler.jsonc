// Cloudflare Workers config: serves the static build in dist/ (no Worker script).
// "name" must match the Worker's name in the Cloudflare dashboard.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "myportfolio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
